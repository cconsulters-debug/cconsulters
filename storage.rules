rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Schadenfotos aus dem Notfall-Formular: Upload für alle (max. 8 MB, nur Bilder),
    // Lesen nur für eingeloggte Admins (Dashboard).
    match /leads/{leadId}/{fileName} {
      allow create: if request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
