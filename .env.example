# ==============================================================
# Umgebungsvariablen – lokal in .env kopieren, im Deploy unter
# Netlify → Site settings → Environment variables eintragen.
# NIEMALS echte Werte committen.
# ==============================================================

# --- Resend (E-Mail-Benachrichtigung) → https://resend.com ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Absender muss eine bei Resend verifizierte Domain sein (oder onboarding@resend.dev zum Testen)
NOTIFY_FROM_EMAIL=leads@abschleppdienstwinti.ch
# Empfänger der Lead-Benachrichtigungen ([EMAIL])
NOTIFY_TO_EMAIL=cconsulters@gmail.com

# --- Telegram Bot (Sofort-Benachrichtigung) → @BotFather ---
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=[TELEGRAM_CHAT_ID]

# --- Firebase Admin (Serverless Functions: Firestore-Zugriff) ---
# Kompletter JSON-Inhalt des Service-Account-Keys als EINE Zeile
# (Firebase Console → Projekteinstellungen → Dienstkonten → Neuen privaten Schlüssel generieren)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Sicherheit ---
# Beliebiger langer Zufallsstring; signiert die "Als kontaktiert markieren"-Links in Telegram
ACTION_SECRET=bitte-langen-zufallsstring-einsetzen

# --- Site ---
# Öffentliche URL der Website (für Links in Telegram/E-Mail + Sitemap)
SITE_URL=https://example.netlify.app

# --- WhatsApp Business API (optional, vorbereitet) ---
# TODO: Sobald Zugang vorhanden, hier eintragen – Hook liegt in send-notification.js
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
