# ==============================================================
# Umgebungsvariablen für "Mein Rechtshelfer & Assistent" (Backend)
# Lokal in .env kopieren; im Deploy unter Netlify → Site settings →
# Environment variables eintragen. NIEMALS echte Werte committen.
# ==============================================================

# --- Firebase (Auth + Firestore) ---
# Firebase Console → Projekteinstellungen → Dienstkonten →
# "Neuen privaten Schlüssel generieren" → kompletten JSON-Inhalt
# als EINE Zeile hier eintragen.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# --- Anthropic (Claude API — erzeugt die Dokumente) ---
# https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=[DEIN-ANTHROPIC-API-KEY]
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Stripe (Zahlung: Karte + TWINT) ---
# https://dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=[DEIN-STRIPE-SECRET-KEY]
# Developers → Webhooks → Endpoint hinzufügen (Ziel: SITE_URL/api/stripe-webhook)
# Events abonnieren: checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET=[DEIN-STRIPE-WEBHOOK-SIGNING-SECRET]
# Products → Abo-Produkt "Flatrate CHF 24.90/Monat" anlegen → Price-ID hier eintragen
STRIPE_ABO_PRICE_ID=[DEINE-STRIPE-PRICE-ID]
# WICHTIG: TWINT-Verfügbarkeit für den eigenen Stripe-Account vor Livegang
# direkt bei Stripe verifizieren (Region/Konto-Freischaltung nötig).

# --- Site ---
SITE_URL=https://mein-rechtshelfer.netlify.app
